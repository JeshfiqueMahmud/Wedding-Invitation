# Copy this file to .env and fill in real values.  .env is git-ignored — never commit it.
#
# ──────────────────────────────────────────────────────────────────────────────
# BACKEND (Express server — locally, and as Render environment variables)
# These are secrets. They must NEVER start with VITE_, or Vite would put them in the website.
# ──────────────────────────────────────────────────────────────────────────────

# Render sets PORT automatically; 5000 is used locally.
PORT=5000

# Supabase → your project → Connect (top bar) → "Session pooler" → URI.
# Replace [YOUR-PASSWORD] with your database password (URL-encode symbols like @ # / ?).
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Optional: path to (or contents of) Supabase's CA certificate for full SSL verification.
# DATABASE_CA_CERT=./prod-ca-2021.crt

# Supabase → Project Settings → Data API (Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "service_role" (legacy) or a "secret" key.
# Full admin access — backend only.
SUPABASE_SERVICE_KEY=your-service-role-key

# Password for the organizer dashboard (RSVP list + photo manager).
ADMIN_PASSWORD=choose-a-long-passphrase

# Comma-separated sites allowed to call the API (localhost is added automatically when NODE_ENV is not production).
ALLOWED_ORIGINS=https://jeshfiquemahmud.github.io

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND (baked into the public website by Vite — only public values here)
# On GitHub these are Repository → Settings → Secrets and variables → Actions → Variables.
# ──────────────────────────────────────────────────────────────────────────────

# Leave empty locally (Vite proxies /api to localhost:5000). On GitHub: your Render URL.
VITE_API_URL=

# Same Project URL as above.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "anon" / publishable key. Public and read-only by design.
VITE_SUPABASE_ANON_KEY=your-anon-key
